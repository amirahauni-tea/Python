> false\n","# in the Forth Iteration filter will pass 13 to the isEven(12) --> true"],"metadata":{"id":"n9Cv1-A3MMdM","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1772502546793,"user_tz":-480,"elapsed":21,"user":{"displayName":"AMIRAH AUNI AZMI","userId":"18171255259022361291"}},"outputId":"471aa4a4-c191-4cbb-e6f0-11a6b152ef59"},"execution_count":45,"outputs":[{"output_type":"execute_result","data":{"text/plain":["[10, 12, 16, 24, 26, 54, 70]"]},"metadata":{},"execution_count":45}]},{"cell_type":"code","source":["# SHORTER WAY: USING LAMBDA\n","numbers = [10,13,11,12,16,17,21,24,26,55,54,70,99,31]\n","list(filter(lambda n:n%2==0,numbers))\n","\n","# filter is the one who will take care of the Iterations\n","# meanning in the First Iteration filter will pass 10 to the lambda 10:10%2==0  --> true\n","# in the Second Iteration filter will pass 13 to the lambda 13:13%2==0 --> false\n","# in the Third Iteration filter will pass 11 to the lambda 11:11%2==0  --> false\n","# in the Forth Iteration filter will pass 12 to the lambda 12:12%2==0  --> true"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vuTBqo1aOW-y","executionInfo":{"status":"ok","timestamp":1772502546795,"user_tz":-480,"elapsed":10,"user":{"displayName":"AMIRAH AUNI AZMI","userId":"18171255259022361291"}},"outputId":"731ef229-41c2-426b-fa7e-f921ebc7ffcf"},"execution_count":46,"outputs":[{"output_type":"execute_result","data":{"text/plain":["[10, 12, 16, 24, 26, 54, 70]"]},"metadata":{},"execution_count":46}]},{"cell_type":"code","source":["emp_names = ['alex','smith','john','Alijah','ariah','mathews','amir','jamison','Aisyah']\n","# using filter please print those emp_names where names starts a or A\n","\n","# using normal function\n","def name(n):\n","  return n.startswith(('a','A'))\n","list(filter(name,emp_names))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kTWaZg0MXDj3","executionInfo":{"status":"ok","timestamp":17725026